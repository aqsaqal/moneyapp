<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/fw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/fw_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY" />
  <TextView
    android:id="@+id/fw_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:text="@string/fw_open"
    android:textColor="#A1A1AA"
    android:textSize="13sp"
    android:visibility="gone" />
  <LinearLayout
    android:id="@+id/fw_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">
    <TextView
      android:id="@+id/fw_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:letterSpacing="0.08"
      android:textAllCaps="true"
      android:textSize="10sp" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="bottom"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/fw_perday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="24sp" />
      <TextView
        android:id="@+id/fw_aday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:textSize="12sp" />
    </LinearLayout>
    <ImageView
      android:id="@+id/fw_bar"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="6dp"
      android:importantForAccessibility="no"
      android:scaleType="fitXY" />
    <TextView
      android:id="@+id/fw_dayline"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:textSize="11sp" />
    <TextView
      android:id="@+id/fw_verdict"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:fontFamily="sans-serif-medium"
      android:maxLines="2"
      android:textSize="12sp" />
    <LinearLayout
      android:id="@+id/fw_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="vertical"
      android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/fw_l1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textSize="12sp" />
        <TextView android:id="@+id/fw_v1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textSize="12sp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/fw_l2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textSize="12sp" />
        <TextView android:id="@+id/fw_v2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textSize="12sp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/fw_l3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textSize="12sp" />
        <TextView android:id="@+id/fw_v3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textSize="12sp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/fw_l4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textSize="12sp" />
        <TextView android:id="@+id/fw_v4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <TextView
    android:id="@+id/fw_locked"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:fontFamily="sans-serif-medium"
    android:textSize="13sp"
    android:visibility="gone" />
</FrameLayout>
